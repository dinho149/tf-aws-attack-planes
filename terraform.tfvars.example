# terraform.tfvars.example
#
# Copy this to terraform.tfvars and edit — `*.tfvars` is gitignored so your real
# values never get committed:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Every variable has a default, so a bare `terraform apply` also works. The one
# you most likely want to set is `alert_email` (otherwise you only see alarms in
# the console, no email).
#
# WARNING: applying this stands up a deliberately-attackable estate and fires a
# simulated attack against your own account. Use a throwaway sandbox account only.

# Home region for the trail. Keep us-east-1 so global-service events (IAM, STS)
# land here.
region = "us-east-1"

# Prefix applied to every named resource so the whole demo is easy to find and
# tear down.
name_prefix = "atkplane"

# Email subscribed to the SNS alert topic. Leave empty ("") to skip the
# subscription — you'll still see alarms in the console, just no email.
# Confirm the subscription in your inbox after apply.
alert_email = "you@example.com"

# If true, the attack Lambda is invoked automatically on apply. Set false to
# stand up the estate and fire the attack yourself later.
auto_fire = true

# Stand up the GuardDuty detector and wire its findings into the detect/respond
# pipeline (EventBridge -> SNS + auto-quarantine Lambda).
#
# GuardDuty is NOT part of the AWS Free Tier, so this defaults to false. Set it
# to true only on an account where you're happy to pay for GuardDuty.
#
# With it false you still get the full trigger -> detect -> investigate loop: the
# CloudTrail metric-filter alarms fire off the attack's own signal. Only the
# GuardDuty-driven auto-quarantine is skipped (you can still invoke the quarantine
# Lambda by hand to demo the response step).
enable_guardduty = false

# Which scenarios (planes) to deploy. Each is a self-contained slice wired to the
# shared foundation.
#
# Scenario 1 (account takeover / control plane) is on by default: it's the
# reference scenario and cheap - no compute, just IAM + CloudTrail alarms.
scenario_01_enabled = true

# Scenario 2 (compromised workload / network plane) is OFF by default because it
# stands up a VPC + a t3.micro EC2 instance (a small ongoing cost, unlike the
# Free-Tier-shaped Scenario 1). Set it to true on a sandbox to exercise the
# VPC Flow Logs egress/lateral-movement loop.
scenario_02_enabled = false

# Scenario 3 (DNS exfil / DNS plane) is OFF by default for the same reason: it
# stands up a VPC + a t3.micro EC2 instance plus Route 53 Resolver query logging.
# Set it to true on a sandbox to exercise the DNS beacon/tunnelling loop caught by
# the scheduled Athena hunter.
scenario_03_enabled = false

# Scenario 3 only: also stand up the Route 53 Resolver DNS Firewall 'prevent'
# control, which BLOCKs the demo beacon/tunnel domains. Off by default so the demo
# is detect-only. A blocked lookup is still logged, so the hunter/queries keep
# working either way - the point is the query is now refused, not just observed.
enable_dns_firewall = false

# Scenario 4 (web attack / web plane) is OFF by default because it stands up a
# public Application Load Balancer + a WAF web ACL, which both bill while they're
# up. This is the PRICIEST scenario in the series - turn it on to exercise the
# WAF-blocks-in-real-time loop, and tear it down (scenario_04_enabled = false and
# re-apply, or terraform destroy) as soon as you're done.
scenario_04_enabled = false

# Scenario 5 (S3 data-events exfil / storage plane) is OFF by default because it
# deliberately turns on a PAID feature: CloudTrail S3 data events (see below),
# billed per object read, on a small "crown jewels" bucket. That's the whole
# lesson - the log that tells you whether data actually left is off until you
# turn it on. Turn it on to exercise the mass-read -> data-event -> alarm ->
# Athena loop, and tear it down when done.
scenario_05_enabled = false

# Scenario 5 only: stand up the scoped CloudTrail S3 data-event trail - the thing
# that actually records object-level GetObject/PutObject/DeleteObject. ON by
# default; without it the exfil leaves NO record (that's the point of the plane).
#
# The experiment the blog ends on: set this to false and re-apply (removes the
# scoped trail), re-fire the attack (./scripts/simulate-attack.sh -s 5), then run
# the s05-01 Athena query again - it returns NOTHING. Data events bill per event,
# so turn this off when you're finished.
enable_data_events = true
